GEMINI_API_KEY=
GEMINI_VISION_PROFILE=optimized
# Local safety budgets, NOT a claim about your Google account's actual quota.
GEMINI_BACKGROUND_VISION=0
GEMINI_RPM_BUDGET=4
GEMINI_INPUT_TPM_BUDGET=16000
GEMINI_RPD_BUDGET=20
GEMINI_INPUT_TOKEN_RESERVATION=4096
GEMINI_FOREGROUND_RESERVE=1

# Standalone voice/Jev goal-loop safety controls (voice uses no Gemini).
JEV_MAX_GOAL_STEPS=10
JEV_MAX_GOAL_SECONDS=60
JEV_MIN_ACTION_CONFIDENCE=0.2
GODOT_ACTION_TIMEOUT_SECONDS=20
# Delay before recording pauses autonomous replanning (backseat-gaming feel).
VOICE_STEERING_DELAY_MS=500
# All app/benchmark processes for one project must share this scope and DB.
GEMINI_QUOTA_SCOPE=default
# GEMINI_QUOTA_DB=/absolute/shared/path/gemini-quota.sqlite3
BACKBOARD_APIKEY=
GODOT_API_URL=http://127.0.0.1:3000/api/v1/commands
# VOICE_DISPATCH=1
